# Optional environment file. Copy to ~/.config/gpu-furnace/furnace.env.
# systemd EnvironmentFile syntax: NAME=value (no "export").
FURNACE_HOST=127.0.0.1
FURNACE_PORT=8787
# Paths below must be absolute when set. Otherwise XDG defaults are used.
# FURNACE_CONFIG=/absolute/path/to/workloads.json
# FURNACE_STATE=/absolute/path/to/state-directory
# FURNACE_TOKEN_FILE=/absolute/path/to/control.token

# Optional Docker bench: provide your own PyTorch image for your driver.
# FURNACE_IMAGE=your-compatible-pytorch-image:tag
# FURNACE_GPU_BACKEND=amd

# Optional synthetic dataset generator: your local OpenAI-compatible server.
FORGE_API=http://127.0.0.1:8000/v1
# FORGE_MODEL=your-served-model-name
# FORGE_TOKEN_FILE=/absolute/path/to/inference-api.token
# FORGE_OUT=/absolute/path/to/forge.jsonl
